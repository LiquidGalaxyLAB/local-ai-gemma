<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2" xmlns:kml="http://www.opengis.net/kml/2.2" xmlns:atom="http://www.w3.org/2005/Atom">
  <Document>
    <!-- ============================================================
         3D PYRAMID TEMPLATE
         Replace the bracketed placeholders below with your values.

         Structure:
           - LookAt: flies camera to the pyramid
           - Ground base square (2D, no altitude)
           - 4 triangular face polygons (altitudeMode=absolute)
           - Center pin at peak base

         Placeholders:
           [name]      — Location name (e.g. "Lleida")
           [lon]       — Center longitude (e.g. 0.627)
           [lat]       — Center latitude  (e.g. 41.618)
           [d]         — Half-width in degrees (~0.015 = ~1.5km)
           [alt]       — Peak altitude in meters (e.g. 2000)
         ============================================================ -->

    <name>3D Pyramid — [name]</name>
    <description>3D pyramid over [name] at [lon]°E, [lat]°N</description>

    <!-- CAMERA: flies Earth to the pyramid -->
    <LookAt>
      <longitude>[lon]</longitude>
      <latitude>[lat]</latitude>
      <altitude>0</altitude>
      <range>8000</range>
      <tilt>60</tilt>
      <heading>0</heading>
    </LookAt>

    <!-- Face styles — replace aabbggrr hex colors as desired -->
    <Style id="faceNorth">
      <LineStyle><color>ffff0000</color><width>2</width></LineStyle>
      <PolyStyle><color>88ff0000</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>
    <Style id="faceEast">
      <LineStyle><color>ff00ff00</color><width>2</width></LineStyle>
      <PolyStyle><color>8800ff00</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>
    <Style id="faceSouth">
      <LineStyle><color>ff0000ff</color><width>2</width></LineStyle>
      <PolyStyle><color>880000ff</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>
    <Style id="faceWest">
      <LineStyle><color>ff00ffff</color><width>2</width></LineStyle>
      <PolyStyle><color>8800ffff</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>

    <Style id="groundBase">
      <LineStyle><color>ffffffff</color><width>2</width></LineStyle>
      <PolyStyle><color>00000000</color><fill>0</fill><outline>1</outline></PolyStyle>
    </Style>

    <Style id="centerPin">
      <IconStyle>
        <color>ffff0000</color><scale>1.5</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href></Icon>
      </IconStyle>
      <LabelStyle><color>ffffffff</color><scale>1.5</scale></LabelStyle>
    </Style>

    <!-- Ground base square -->
    <Placemark>
      <name>Base</name>
      <styleUrl>#groundBase</styleUrl>
      <Polygon>
        <tessellate>1</tessellate>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              [lon_minus_d],[lat_plus_d],0
              [lon_plus_d],[lat_plus_d],0
              [lon_plus_d],[lat_minus_d],0
              [lon_minus_d],[lat_minus_d],0
              [lon_minus_d],[lat_plus_d],0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <!-- NORTH FACE -->
    <Placemark>
      <name>North Face</name>
      <styleUrl>#faceNorth</styleUrl>
      <Polygon>
        <altitudeMode>absolute</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              [lon_minus_d],[lat_plus_d],0
              [lon_plus_d],[lat_plus_d],0
              [lon],[lat],[alt]
              [lon_minus_d],[lat_plus_d],0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <!-- EAST FACE -->
    <Placemark>
      <name>East Face</name>
      <styleUrl>#faceEast</styleUrl>
      <Polygon>
        <altitudeMode>absolute</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              [lon_plus_d],[lat_plus_d],0
              [lon_plus_d],[lat_minus_d],0
              [lon],[lat],[alt]
              [lon_plus_d],[lat_plus_d],0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <!-- SOUTH FACE -->
    <Placemark>
      <name>South Face</name>
      <styleUrl>#faceSouth</styleUrl>
      <Polygon>
        <altitudeMode>absolute</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              [lon_plus_d],[lat_minus_d],0
              [lon_minus_d],[lat_minus_d],0
              [lon],[lat],[alt]
              [lon_plus_d],[lat_minus_d],0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <!-- WEST FACE -->
    <Placemark>
      <name>West Face</name>
      <styleUrl>#faceWest</styleUrl>
      <Polygon>
        <altitudeMode>absolute</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              [lon_minus_d],[lat_minus_d],0
              [lon_minus_d],[lat_plus_d],0
              [lon],[lat],[alt]
              [lon_minus_d],[lat_minus_d],0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <!-- Center pin -->
    <Placemark>
      <name>[name]</name>
      <styleUrl>#centerPin</styleUrl>
      <Point>
        <coordinates>[lon],[lat],0</coordinates>
      </Point>
    </Placemark>

  </Document>
</kml>
