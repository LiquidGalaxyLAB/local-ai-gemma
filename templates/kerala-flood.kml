<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Kerala Flood 2018 — Impact Zones</name>
  <description>Kerala flood affected areas with severity zones</description>

  <LookAt>
    <longitude>76.5</longitude>
    <latitude>9.8</latitude>
    <altitude>0</altitude>
    <range>300000</range>
    <tilt>45</tilt>
    <heading>0</heading>
  </LookAt>

  <Style id="severeFlood">
    <LineStyle><color>ffff0000</color><width>3.0</width></LineStyle>
    <PolyStyle><color>66ff0000</color></PolyStyle>
  </Style>
  <Style id="moderateFlood">
    <LineStyle><color>ffff6600</color><width>2.5</width></LineStyle>
    <PolyStyle><color>66ff6600</color></PolyStyle>
  </Style>
  <Style id="floodLabel">
    <IconStyle>
      <scale>1.2</scale>
      <Icon><href>http://maps.google.com/mapfiles/kml/shapes/placemark_circle.png</href></Icon>
    </IconStyle>
    <LabelStyle><color>ffff00ff</color><scale>1.1</scale></LabelStyle>
  </Style>

  <!-- Severe flood zones — central Kerala districts hardest hit -->
  <Placemark>
    <name>🔴 Severe — Idukki Region</name>
    <styleUrl>#severeFlood</styleUrl>
    <Polygon>
      <tessellate>1</tessellate>
      <outerBoundaryIs><LinearRing><coordinates>
        76.75,10.20,0  76.85,10.15,0  77.00,10.10,0  77.10,10.00,0
        77.05,9.85,0   76.95,9.75,0   76.85,9.70,0   76.75,9.75,0
        76.70,9.85,0   76.65,9.95,0   76.70,10.10,0  76.75,10.20,0
      </coordinates></LinearRing></outerBoundaryIs>
    </Polygon>
  </Placemark>

  <Placemark>
    <name>🔴 Severe — Ernakulam / Kochi</name>
    <styleUrl>#severeFlood</styleUrl>
    <Polygon>
      <tessellate>1</tessellate>
      <outerBoundaryIs><LinearRing><coordinates>
        76.25,10.10,0  76.35,10.05,0  76.45,10.00,0  76.50,9.95,0
        76.45,9.85,0   76.35,9.80,0   76.25,9.85,0   76.20,9.95,0
        76.22,10.05,0  76.25,10.10,0
      </coordinates></LinearRing></outerBoundaryIs>
    </Polygon>
  </Placemark>

  <Placemark>
    <name>🟠 Moderate — Alappuzha / Kuttanad</name>
    <styleUrl>#moderateFlood</styleUrl>
    <Polygon>
      <tessellate>1</tessellate>
      <outerBoundaryIs><LinearRing><coordinates>
        76.35,9.55,0   76.45,9.50,0   76.50,9.45,0   76.55,9.40,0
        76.45,9.35,0   76.35,9.30,0   76.28,9.35,0   76.25,9.42,0
        76.28,9.50,0   76.35,9.55,0
      </coordinates></LinearRing></outerBoundaryIs>
    </Polygon>
  </Placemark>

  <Placemark>
    <name>🟠 Moderate — Thrissur / Palakkad</name>
    <styleUrl>#moderateFlood</styleUrl>
    <Polygon>
      <tessellate>1</tessellate>
      <outerBoundaryIs><LinearRing><coordinates>
        76.20,10.55,0  76.30,10.50,0  76.40,10.45,0  76.45,10.40,0
        76.35,10.30,0  76.25,10.25,0  76.15,10.30,0  76.10,10.38,0
        76.12,10.48,0  76.20,10.55,0
      </coordinates></LinearRing></outerBoundaryIs>
    </Polygon>
  </Placemark>

  <!-- City markers -->
  <Folder>
    <name>Affected Cities</name>
    <Placemark>
      <name>Kochi</name>
      <styleUrl>#floodLabel</styleUrl>
      <Point><coordinates>76.2673,9.9312,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Alappuzha</name>
      <styleUrl>#floodLabel</styleUrl>
      <Point><coordinates>76.3388,9.4981,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Idukki Dam</name>
      <styleUrl>#floodLabel</styleUrl>
      <Point><coordinates>76.97,9.85,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Thrissur</name>
      <styleUrl>#floodLabel</styleUrl>
      <Point><coordinates>76.2146,10.5276,0</coordinates></Point>
    </Placemark>
  </Folder>
</Document>
</kml>
