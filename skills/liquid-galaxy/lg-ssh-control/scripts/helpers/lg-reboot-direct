#!/bin/bash
PW="lg"
. ${HOME}/etc/shell.conf
me=$(hostname)
# Reboot remote frames first, then self last
for lg in $LG_FRAMES; do
  [ "$lg" = "$me" ] && continue
  sshpass -p "$PW" ssh -o ConnectTimeout=5 -t -x lg@$lg "echo '$PW' | sudo -S reboot" 2>/dev/null || echo "  $lg unreachable, skipping"
done
# Self last
echo "$PW" | sudo -S reboot
