#!/bin/bash
# lg-slave-master-refresh-set
# Adds flyToView=1 + 3s refreshInterval to the Master KML NetworkLink
# on ALL slave frames (frame-count-agnostic via $LG_FRAMES).
# Run once, then relaunch Earth so slaves pick up the myplaces.kml change.
# After that, any master.kml update auto-propagates to all screens within 3s.
PW="lg"
. ${HOME}/etc/shell.conf

me=$(hostname)
for lg in $LG_FRAMES; do
  [ "$lg" = "$me" ] && continue
  echo "  $lg: adding flyToView+refresh to Master KML NetworkLink..."
  sshpass -p "$PW" ssh -o ConnectTimeout=5 -t lg@$lg \
    "echo '$PW' | sudo -S sed -i '/master.kml<\/href>/{n;s/<\/Link>/<flyToView>1<\/flyToView><refreshMode>onInterval<\/refreshMode><refreshInterval>3<\/refreshInterval><\/Link>/}' ~/earth/kml/slave/myplaces.kml" 2>/dev/null
  echo "  $lg: done"
done
