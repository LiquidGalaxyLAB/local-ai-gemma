<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2"
     xmlns:atom="http://www.w3.org/2005/Atom">
  <Document>
    <name>Taj Mahal Explorer</name>
    <visibility>1</visibility>
    <open>1</open>

    <!-- Auto-position camera on initial load -->
    <LookAt>
      <longitude>78.0422</longitude>
      <latitude>27.1751</latitude>
      <altitude>0</altitude>
      <heading>180</heading>
      <tilt>70</tilt>
      <range>200</range>
      <altitudeMode>relativeToGround</altitudeMode>
    </LookAt>

    <!-- NetworkLink to CGI — La Palma pattern, 2s refresh on stop -->
    <NetworkLink>
      <name>View Centered Refresh</name>
      <visibility>0</visibility>
      <open>0</open>
      <refreshVisibility>0</refreshVisibility>
      <flyToView>0</flyToView>
      <Link>
        <href>http://lg1:81/cgi-bin/viewCenteredPlacemark.py?</href>
        <refreshInterval>2</refreshInterval>
        <viewRefreshMode>onStop</viewRefreshMode>
        <viewRefreshTime>1</viewRefreshTime>
      </Link>
    </NetworkLink>

    <!-- Styles -->
    <Style id="tajIcon">
      <IconStyle>
        <scale>1.5</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <color>ffffffff</color>
        <scale>1.2</scale>
      </LabelStyle>
      <BalloonStyle>
        <text><![CDATA[
          <html><body style="margin:0px;overflow:auto;background:#1a1a2e;">
          <table style="font-family:Arial;font-size:14px;width:100%;color:#eee;">
          <tr style="background:#e94560;"><td style="padding:12px;"><h2 style="margin:0;">$[name]</h2></td></tr>
          <tr><td style="padding:12px;background:#16213e;">
          <b>Location:</b> Agra, Uttar Pradesh, India<br>
          <b>Built:</b> 1632-1653<br>
          <b>Height:</b> 73m (240 ft)<br>
          <b>UNESCO:</b> World Heritage Site
          </td></tr></table></body></html>
        ]]></text>
      </BalloonStyle>
    </Style>

    <Style id="gateIcon">
      <IconStyle>
        <scale>1.0</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <Style id="areaStyle">
      <LineStyle><color>ffff8800</color><width>2</width></LineStyle>
      <PolyStyle><color>40ff8800</color><outline>1</outline></PolyStyle>
    </Style>

    <!-- Main Taj Mahal -->
    <Placemark>
      <name>Taj Mahal</name>
      <styleUrl>#tajIcon</styleUrl>
      <description><![CDATA[
        <html><body style="margin:0px;overflow:auto;background:#1a1a2e;">
        <table style="font-family:Arial;font-size:14px;width:100%;color:#eee;">
        <tr style="background:#e94560;"><td style="padding:12px;"><h2 style="margin:0;">Taj Mahal</h2></td></tr>
        <tr><td style="padding:12px;background:#16213e;">
        Marble mausoleum on the Yamuna riverbank.<br>
        Built by Shah Jahan for Mumtaz Mahal.
        </td></tr></table></body></html>
      ]]></description>
      <Point>
        <coordinates>78.0422,27.1751,0</coordinates>
      </Point>
    </Placemark>

    <!-- Gate -->
    <Placemark>
      <name>Great Gate (Darwaza)</name>
      <styleUrl>#gateIcon</styleUrl>
      <Point><coordinates>78.0400,27.1720,0</coordinates></Point>
    </Placemark>

    <!-- Mosque -->
    <Placemark>
      <name>Mosque (Masjid)</name>
      <styleUrl>#gateIcon</styleUrl>
      <Point><coordinates>78.0405,27.1751,0</coordinates></Point>
    </Placemark>

    <!-- Guest House -->
    <Placemark>
      <name>Guest House (Jawab)</name>
      <styleUrl>#gateIcon</styleUrl>
      <Point><coordinates>78.0439,27.1751,0</coordinates></Point>
    </Placemark>

    <!-- Complex boundary polygon -->
    <Placemark>
      <name>Taj Mahal Complex</name>
      <styleUrl>#areaStyle</styleUrl>
      <Polygon>
        <extrude>0</extrude>
        <altitudeMode>clampToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              78.0370,27.1700,0 78.0470,27.1700,0
              78.0470,27.1800,0 78.0370,27.1800,0
              78.0370,27.1700,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <!-- Yamuna River -->
    <Placemark>
      <name>Yamuna River</name>
      <Style>
        <LineStyle><color>ff4444ff</color><width>3</width></LineStyle>
      </Style>
      <LineString>
        <altitudeMode>clampToGround</altitudeMode>
        <coordinates>
          78.0400,27.1680,0 78.0415,27.1710,0 78.0425,27.1740,0
          78.0435,27.1770,0 78.0445,27.1800,0 78.0455,27.1830,0
          78.0465,27.1860,0
        </coordinates>
      </LineString>
    </Placemark>

  </Document>
</kml>
