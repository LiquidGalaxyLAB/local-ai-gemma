<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2">
  <Document>
    <name>Compact Orbit Tour</name>

    <LookAt>
      <longitude>LON</longitude>
      <latitude>LAT</latitude>
      <altitude>0</altitude>
      <heading>0</heading>
      <tilt>TILT</tilt>
      <range>RNG</range>
      <altitudeMode>relativeToGround</altitudeMode>
    </LookAt>

    <Placemark>
      <name>Target</name>
      <Point>
        <coordinates>LON,LAT,0</coordinates>
      </Point>
    </Placemark>

    <!-- Tour named "Orbit" — trigger: echo 'playtour=Orbit' > /tmp/query.txt -->
    <gx:Tour>
      <name>Orbit</name>
      <gx:Playlist>
        <gx:FlyTo>
          <gx:duration>4.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>LON</longitude><latitude>LAT</latitude>
            <altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>0</heading>
            <altitudeMode>relativeToGround</altitudeMode>
          </LookAt>
        </gx:FlyTo>
        <gx:Wait><gx:duration>2.0</gx:duration></gx:Wait>

        <gx:FlyTo><gx:duration>2.0</gx:duration><gx:flyToMode>smooth</gx:flyToMode><LookAt><longitude>LON</longitude><latitude>LAT</latitude><altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>30</heading><altitudeMode>relativeToGround</altitudeMode></LookAt></gx:FlyTo>
        <gx:FlyTo><gx:duration>2.0</gx:duration><gx:flyToMode>smooth</gx:flyToMode><LookAt><longitude>LON</longitude><latitude>LAT</latitude><altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>60</heading><altitudeMode>relativeToGround</altitudeMode></LookAt></gx:FlyTo>
        <gx:FlyTo><gx:duration>2.0</gx:duration><gx:flyToMode>smooth</gx:flyToMode><LookAt><longitude>LON</longitude><latitude>LAT</latitude><altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>90</heading><altitudeMode>relativeToGround</altitudeMode></LookAt></gx:FlyTo>
        <gx:FlyTo><gx:duration>2.0</gx:duration><gx:flyToMode>smooth</gx:flyToMode><LookAt><longitude>LON</longitude><latitude>LAT</latitude><altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>120</heading><altitudeMode>relativeToGround</altitudeMode></LookAt></gx:FlyTo>
        <gx:FlyTo><gx:duration>2.0</gx:duration><gx:flyToMode>smooth</gx:flyToMode><LookAt><longitude>LON</longitude><latitude>LAT</latitude><altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>150</heading><altitudeMode>relativeToGround</altitudeMode></LookAt></gx:FlyTo>
        <gx:FlyTo><gx:duration>2.0</gx:duration><gx:flyToMode>smooth</gx:flyToMode><LookAt><longitude>LON</longitude><latitude>LAT</latitude><altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>180</heading><altitudeMode>relativeToGround</altitudeMode></LookAt></gx:FlyTo>
        <gx:FlyTo><gx:duration>2.0</gx:duration><gx:flyToMode>smooth</gx:flyToMode><LookAt><longitude>LON</longitude><latitude>LAT</latitude><altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>210</heading><altitudeMode>relativeToGround</altitudeMode></LookAt></gx:FlyTo>
        <gx:FlyTo><gx:duration>2.0</gx:duration><gx:flyToMode>smooth</gx:flyToMode><LookAt><longitude>LON</longitude><latitude>LAT</latitude><altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>240</heading><altitudeMode>relativeToGround</altitudeMode></LookAt></gx:FlyTo>
        <gx:FlyTo><gx:duration>2.0</gx:duration><gx:flyToMode>smooth</gx:flyToMode><LookAt><longitude>LON</longitude><latitude>LAT</latitude><altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>270</heading><altitudeMode>relativeToGround</altitudeMode></LookAt></gx:FlyTo>
        <gx:FlyTo><gx:duration>2.0</gx:duration><gx:flyToMode>smooth</gx:flyToMode><LookAt><longitude>LON</longitude><latitude>LAT</latitude><altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>300</heading><altitudeMode>relativeToGround</altitudeMode></LookAt></gx:FlyTo>
        <gx:FlyTo><gx:duration>2.0</gx:duration><gx:flyToMode>smooth</gx:flyToMode><LookAt><longitude>LON</longitude><latitude>LAT</latitude><altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>330</heading><altitudeMode>relativeToGround</altitudeMode></LookAt></gx:FlyTo>
        <gx:FlyTo><gx:duration>2.0</gx:duration><gx:flyToMode>smooth</gx:flyToMode><LookAt><longitude>LON</longitude><latitude>LAT</latitude><altitude>0</altitude><range>RNG</range><tilt>TILT</tilt><heading>360</heading><altitudeMode>relativeToGround</altitudeMode></LookAt></gx:FlyTo>
      </gx:Playlist>
    </gx:Tour>
  </Document>
</kml>
