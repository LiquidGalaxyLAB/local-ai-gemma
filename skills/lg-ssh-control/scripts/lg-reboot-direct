#!/bin/bash
PW="lg"
. ${HOME}/etc/shell.conf
me=$(hostname)
# Reboot other frames first, then self last
# SSH exits 255 on reboot (connection drops) — that's expected, not failure
for lg in $LG_FRAMES; do
  [ "$lg" = "$me" ] && continue
  sshpass -p "$PW" ssh -o ConnectTimeout=5 -t -x lg@$lg "echo '$PW' | sudo -S reboot" 2>/dev/null
  echo "  $lg: reboot sent"
done
# Self last
echo "$PW" | sudo -S reboot
