#!/bin/bash
# Reset KML refresh on slave screens — corrected approach
# Removes <refreshMode>/<refreshInterval> from inside <Link>
# Uses slave_x.kml (PHP-variable form, same on all slaves)
# Skips unreachable frames without aborting
PW="lg"
. ${HOME}/etc/shell.conf
for lg in $LG_FRAMES; do
  [ "$lg" = "$(hostname)" ] && continue
  sshpass -p "$PW" ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 -t lg@$lg \
    "echo '$PW' | sudo -S sed -i '\\|<href>[^<]*slave_x.kml</href>|{n;s|<refreshMode>onInterval</refreshMode><refreshInterval>[0-9]\\+</refreshInterval></Link>|</Link>|}' ~/earth/kml/slave/myplaces.kml" 2>/dev/null || echo "  $lg unreachable, skipping"
  echo "  $lg: refresh reset"
done
